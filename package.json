{
  "name": "poc-lab",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "pnpm --filter web run dev",
    "baixar-base": "pnpm --filter processamento run baixar-base",
    "preparar": "pnpm --filter processamento run preparar",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "test:scripts": "node --test scripts/*.test.mjs",
    "publicar:dados": "node scripts/publicar.mjs dados",
    "publicar:site": "node scripts/publicar.mjs site",
    "publicar": "node scripts/publicar.mjs tudo"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-plugin-react": "^7.37.0"
  }
}
