{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "@cloudflare/workers-types"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "worker/**/*.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "vite.config.ts",
    "wrangler.jsonc"
  ],
  "exclude": ["node_modules", "dist"]
}
